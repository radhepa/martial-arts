  "environment": "*",
  "entrypoints": {
    "main": ["dev.martialarts.MartialArts"],
    "client": ["dev.martialarts.client.MartialArtsClient"]
  },
  "mixins": [{"config": "martial_arts.client.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
